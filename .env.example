# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values before running.
# NEVER commit `.env`. Vercel should get these via Vercel Env Vars.
# ------------------------------------------------------------------

# Supabase project URL (Settings > API).
VITE_SUPABASE_URL=

# Supabase "anon" (publishable) key ONLY. Never the service_role key.
VITE_SUPABASE_ANON_KEY=

# SITE NAME shown across the storefront (header title text, SEO suffix).
VITE_SITE_NAME=Catalog Site

# WhatsApp Business number in international format, digits only, no '+'.
# Example US: 15551234567  (whatsapp.me/15551234567)
VITE_WHATSAPP_NUMBER=

# Default message the customer sees as their WhatsApp chat opens.
VITE_WHATSAPP_INTRO=Hello! I would like to place an order:

# Hosting origin used for canonical URLs / sitemap. No trailing slash.
# Should match the deployed domain (e.g. https://shop.example.com)
VITE_SITE_URL=

# Currency used for price formatting (ISO 4217 code).
VITE_CURRENCY=USD

# Optional label prefix for prices, e.g. "$" or "$" displayed before value.
VITE_CURRENCY_LABEL=